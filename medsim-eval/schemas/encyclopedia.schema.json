{
  "$defs": {
    "Entry": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "drug",
            "equipment",
            "term"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "description": "Short reference text",
          "title": "Text",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "see_also": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "See Also",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "text",
        "source"
      ],
      "title": "Entry",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value came from. `doc` is a short citation; `url` is where to read it.",
      "properties": {
        "doc": {
          "title": "Doc",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Table, page or section within the document",
          "title": "Locator"
        }
      },
      "required": [
        "doc"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "note",
    "entries"
  ],
  "title": "Encyclopedia",
  "type": "object"
}
