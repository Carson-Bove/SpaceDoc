{
  "$defs": {
    "Anchors": {
      "additionalProperties": false,
      "description": "Written descriptions of what a 1, a 3 and a 5 look like. 2 and 4 sit between them.",
      "properties": {
        "1": {
          "title": "1",
          "type": "string"
        },
        "3": {
          "title": "3",
          "type": "string"
        },
        "5": {
          "title": "5",
          "type": "string"
        }
      },
      "required": [
        "1",
        "3",
        "5"
      ],
      "title": "Anchors",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "anchors": {
          "$ref": "#/$defs/Anchors"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "anchors"
      ],
      "title": "Domain",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "Critical error (never event): any occurrence fails the run",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Gate",
      "type": "object"
    },
    "LibraryItem": {
      "additionalProperties": false,
      "description": "A common checklist item a clerk can add with one click, then adjust.",
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "weight": {
          "maximum": 10,
          "minimum": -10,
          "title": "Weight",
          "type": "integer"
        },
        "domain": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Domain",
          "type": "string"
        },
        "tags": {
          "default": [],
          "description": "e.g. abdominal, trauma, any",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "weight",
        "domain"
      ],
      "title": "LibraryItem",
      "type": "object"
    },
    "OutcomeMeasure": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "OutcomeMeasure",
      "type": "object"
    },
    "StandardItem": {
      "additionalProperties": false,
      "description": "Scored in every scenario, from the ground truth, without the clerk writing it.",
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Weight",
          "type": "integer"
        },
        "domain": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Domain",
          "type": "string"
        },
        "depends_on": {
          "anyOf": [
            {
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only scored if this other standard item was met (partial credit chain)",
          "title": "Depends On"
        }
      },
      "required": [
        "id",
        "text",
        "weight",
        "domain"
      ],
      "title": "StandardItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "rubric_id": {
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Rubric Id",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/Gate"
      },
      "title": "Gates",
      "type": "array"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/Domain"
      },
      "title": "Domains",
      "type": "array"
    },
    "outcomes": {
      "items": {
        "$ref": "#/$defs/OutcomeMeasure"
      },
      "title": "Outcomes",
      "type": "array"
    },
    "standard_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StandardItem"
      },
      "title": "Standard Items",
      "type": "array"
    },
    "item_library": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LibraryItem"
      },
      "title": "Item Library",
      "type": "array"
    },
    "changelog": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Changelog",
      "type": "array"
    }
  },
  "required": [
    "rubric_id",
    "version",
    "title",
    "gates",
    "domains",
    "outcomes"
  ],
  "title": "BaseRubric",
  "type": "object"
}
